# NyxCoreLabs Astro Slide 5G
# Initial Halium 11 kernel configuration requirements.
#
# Applied on top of k6873v1_64_defconfig.
# Experimental candidate; not verified on physical hardware.

CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
